{
  "manifest_version": 3,
  "name": "Members Begone",
  "version": "0.1.1",
  "description": "Fjerner Members only-videoer og medlemslokkemad fra YouTube-feedet.",
  "minimum_chrome_version": "102",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_title": "Members Begone",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "css": [
        "src/content.css"
      ],
      "js": [
        "src/detector.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
